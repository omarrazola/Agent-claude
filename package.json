{
  "name": "uber-base-design-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Agentes autónomos de diseño UX/UI con Uber Base Design System (base.uber.com).",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo:local": "tsx scripts/run-local.ts fixtures/jira-issue-created.json",
    "demo:trello": "tsx scripts/run-local.ts fixtures/trello-card-moved.json",
    "iterate": "tsx scripts/iterate.ts",
    "team:verify": "tsx scripts/verify-team-setup.ts",
    "team:start": "tsx scripts/start-team-test.ts",
    "team:test:happy": "tsx scripts/run-local.ts fixtures/team-tests/01-happy-path-nueva-funcionalidad.json",
    "team:test:ambiguo": "tsx scripts/run-local.ts fixtures/team-tests/02-ticket-ambiguo-preguntas-abiertas.json",
    "team:test:corner": "tsx scripts/run-local.ts fixtures/team-tests/03-corner-case-resiliencia.json",
    "mcp:start": "node scripts/design-system-mcp.mjs",
    "mcp:test": "node scripts/test-mcp-client.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@google/genai": "^2.30.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/ws": "^8.18.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
