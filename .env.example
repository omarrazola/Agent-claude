# ==============================================================================
# Albora Design Agents - Configuración de entorno
# ==============================================================================

# Puerto local del servidor HTTP
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787

# Modo simulación: si es true, no escribe en Jira ni en Trello (ideal para pruebas)
DRY_RUN=true

# Proveedor LLM: "gemini" | "anthropic" | "mock"
# Se auto-detecta según la clave presente. Si no hay clave, usa "mock" para pruebas offline.
LLM_PROVIDER=gemini

# --- Google Gemini (Recomendado en Antigravity) ---
# Obtén tu clave en: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Anthropic Claude (Opcional) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# --- Jira Cloud (Opcional para webhooks e integración real) ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=KAN
JIRA_WEBHOOK_TOKEN=
JIRA_TRIGGER_LABEL=diseño
JIRA_TRANSITION_REVIEW_ID=
JIRA_TRANSITION_DEV_ID=

# --- Trello (Opcional para webhooks e integración real) ---
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_APP_SECRET=
TRELLO_TRIGGER_LIST_NAME=Diseño · Nuevo
TRELLO_REVIEW_LIST_ID=
TRELLO_DEV_LIST_ID=

# --- Figma (Opcional) ---
FIGMA_ACCESS_TOKEN=
FIGMA_FILE_KEY=
